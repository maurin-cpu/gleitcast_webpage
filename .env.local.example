# Tracking — nur aktiv, wenn gesetzt UND der Nutzer im Banner zustimmt.
# Kopiere diese Datei zu .env.local und trage die echten Werte ein.
# Ohne diese Werte läuft die Seite ganz ohne Tracking (z. B. lokal).

# Google Analytics 4 — Mess-ID aus GA4 (Admin → Datenströme).
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# PostHog — Project-API-Key. WICHTIG: EU-Projekt anlegen (eu.posthog.com),
# nicht US.
NEXT_PUBLIC_POSTHOG_KEY=phc_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Host = Reverse-Proxy-Pfad "/ingest" (Default, siehe next.config.mjs → leitet
# first-party an die EU-Cloud weiter; umgeht Adblocker). In der Regel NICHT setzen.
NEXT_PUBLIC_POSTHOG_HOST=/ingest
